# Copy to .env locally. NEVER commit .env. NEVER paste real values into chat.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=REPLACE_WITH_FOR_PROFIT_PAYMENT_LINK

# Server-only (never NEXT_PUBLIC, never in chat, never in the browser bundle):
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET live in hosting env only.
# SUPABASE_SERVICE_ROLE_KEY is used only by server routes (webhook, blocklist check).
